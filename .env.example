# Copy to .env. Never commit .env. Do not paste real values into chat.

# Marketplace origin. Catalog, worker API, and OAuth live here.
# https://docs.market.near.ai/list-your-agent
MARKET_BASE_URL=https://market.near.ai

# How live hops pay.
# mcp-prepare: POST tools on https://market.near.ai/mcp — prepare_job does not charge; you pay on approval_url.
#   https://docs.market.near.ai/mcp/connect.md
#   https://market.near.ai/skill/mcp-buyer/SKILL.md
# mcp-pro: https://market.near.ai/mcp/pro — create_job holds the price in the call. Confirm in the Relay UI first.
#   https://docs.market.near.ai/mcp/pro.md
#   https://market.near.ai/skill/mcp-buyer/PRO.md
# x402: wallet payment. Use this only when the payer account does not own the agent (own-agent x402 returns -32602).
#   https://docs.market.near.ai/a2a/hire-agent-using-x402.md
LIVE_PAY_MODE=mcp-prepare

# Buyer MCP URL. Leave unset to follow LIVE_PAY_MODE.
# MARKET_MCP_URL=https://market.near.ai/mcp

# Handles you create at Building → Your agents → New agent. Hosting: Self-hosted. Webhook empty.
# https://docs.market.near.ai/list-your-agent
RELAY_SPECIALIST_HANDLE=
RELAY_FINISHER_HANDLE=

# Agent API tokens from each agent's Edit page. Shown once. Prefix aat_.
# https://docs.market.near.ai/guides/self-hosted-agents.md
SPECIALIST_AGENT_API_TOKEN=
FINISHER_AGENT_API_TOKEN=

# Buyer login for a hosted deploy. Locally, npm run mcp-login writes data/mcp-oauth.json instead.
# Set these in the host's environment. Do not commit the values.
# MARKET_MCP_CLIENT_ID=
# MARKET_MCP_ACCESS_TOKEN=
# MARKET_MCP_REFRESH_TOKEN=
# MARKET_MCP_EXPIRES_AT=

# Only for LIVE_PAY_MODE=x402. A dedicated NEAR account with a tiny USDC balance.
# The USDC contract and payTo come from the HTTP 402 body, not from this file.
# https://docs.market.near.ai/a2a/hire-agent-using-x402.md
# RPC used while signing: https://rpc.<networkId>.fastnear.com as in that guide.
X402_ACCOUNT_ID=
X402_PRIVATE_KEY=
# Optional. Set when the 402 body lists more than one near: row. Example shape: near:mainnet
X402_NETWORK=

# Not used in v1. 1Click has no testnet. A later quote must send dry:true.
# Unauthenticated fee on the live 1Click page is 0.25%, not the 0.2% in HACKATHON.md Q-006.
# https://docs.near-intents.org/integration/distribution-channels/1click-api/quickstart/making-a-request.md
# ONECLICK_JWT=

# Not used in v1. Agent API demo host from the track prompt.
# https://docs.agentsonintents.com/integration/agent-api/overview
# https://partners.demo.agentsonintents.com/dashboard
# NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
# NEAR_INTENTS_AGENT_API_KEY=
